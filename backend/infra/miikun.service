[Unit]
Description=Miikun FastAPI Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/var/www/miikun
EnvironmentFile=/var/www/miikun/backend/.env
ExecStart=/var/www/miikun/backend/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
